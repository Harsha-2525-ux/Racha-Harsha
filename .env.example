# Copy this file to ".env" and fill in your Supabase project credentials.
# Find these in your Supabase dashboard: Project Settings → API.
#
# Without these, Margly runs in LOCAL DEMO MODE (no accounts; data stays in the
# browser). With them, real email/password accounts and cloud sync are enabled.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
